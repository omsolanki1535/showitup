# --- Required ---------------------------------------------------------------
PORT=8000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/showitup
# Use a long random string (32+ characters is required in production).
JWT_SECRET=replace-with-a-long-random-secret
# Frontend origin(s) allowed to call the API, comma separated.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8000

# --- Optional: leave blank to run that feature in demo mode -----------------
# OTP and ticket emails. Blank = OTP is printed in the backend logs.
EMAIL=
PASSWORD=
# Razorpay. Blank = demo payments (no money moves, bookings still work).
RAZORPAY_KEY=
RAZORPAY_KEY_SECRET=
# Google Gemini chatbot. Blank = chatbot replies that it is not configured.
GEMINI_API_KEY=

# --- Optional tuning ---------------------------------------------------------
# CONVENIENCE_FEE=50
# Ping the server every 10 minutes so free hosting tiers do not sleep.
# KEEP_ALIVE=true
# Set to false only when serving frontend and API from one plain-HTTP origin.
# COOKIE_SECURE=true
# Used by `npm test` for the end-to-end API tests (database is wiped).
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/showitup_test
